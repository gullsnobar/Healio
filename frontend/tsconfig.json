{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "App.js",
    "firebase.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".expo"
  ]
}
