{
  "expo": {
    "name": "MR & FT",
    "slug": "mr-ft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90D9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healio.app",
      "infoPlist": {
        "NSMotionUsageDescription": "MR & FT needs access to motion data for step tracking.",
        "NSHealthShareUsageDescription": "MR & FT needs access to health data for fitness tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#4A90D9"
      },
      "package": "com.healio.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-notifications",
      "expo-location",
      "expo-image-picker",
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "e4297a6f-2c35-4148-8833-b5c86499e59c"
      }
    }
  }
}
