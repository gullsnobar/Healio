NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/healio?retryWrites=true&w=majority
MONGODB_TEST_URI=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-make-it-long-and-random
JWT_EXPIRE=30m
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRE=7d

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_SERVICE_ACCOUNT_PATH=./config/healio-bba24-firebase-adminsdk-fbsvc-b272baeefc.json

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Email Configuration (Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# HuggingFace Configuration
HuggingFace_API_KEY=hf_your-huggingface-token-here

# Gemini Configuration
GEMINI_API_KEY=
AI_PROVIDER=gemini

# Google Fit Configuration
GOOGLE_FIT_CLIENT_ID=your-google-fit-client-id
GOOGLE_FIT_CLIENT_SECRET=your-google-fit-client-secret
GOOGLE_FIT_API_KEY=your-google-fit-api-key

CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_PROJECT_ID=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

AI_ENGINE_URL=http://localhost:8000

ENCRYPTION_KEY=your-32-char-encryption-key-here
SESSION_SECRET=your-session-secret

RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
